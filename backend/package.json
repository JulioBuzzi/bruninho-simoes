{
  "name": "bruninho-simoes-api",
  "version": "1.0.0",
  "description": "API para o sistema de notas do canal Bruninho e Simões",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "echo 'No build step needed'",
    "db:list": "node dbUtils.js list",
    "db:migrate": "node migrateFromSupabase.js",
    "db:migrate-file": "node migrateFromSupabase.js from-file",
    "db:backup": "cp data.json backup/data_$(date +\\%Y\\%m\\%d_\\%H\\%M\\%S).json && echo '✅ Backup criado'",
    "db:reset": "node dbUtils.js reset"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
