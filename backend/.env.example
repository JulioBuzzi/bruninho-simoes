# ═══════════════════════════════════════════════════════════════════
# VARIÁVEIS DE AMBIENTE - Copie para .env
# ═══════════════════════════════════════════════════════════════════

# DESENVOLVIMENTO (seu PC)
NODE_ENV=development
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:6543/postgres
FRONTEND_URL=http://localhost:3000
PORT=3001

# PRODUÇÃO: não coloque valores reais aqui.
# Configure direto no painel do Render (Environment) e da Vercel.

# JWT (autenticação)
JWT_SECRET=troque_por_uma_chave_aleatoria_com_32_ou_mais_caracteres
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# ═══════════════════════════════════════════════════════════════════
# COMO USAR:
# 1. cp .env.example .env
# 2. Preencha DATABASE_URL com a connection string do Supabase
#    (Supabase → Project Settings → Database → Connection string)
# 3. npm run dev
#
# ⚠️ NUNCA commite o .env (já está no .gitignore)
# ═══════════════════════════════════════════════════════════════════